---
import Base from '@layouts/Base.astro';
---

<Base
  title="Atmofrost · Not Found"
  description="The requested Atmofrost page could not be found."
>
  <h1 class="af-title">That page is <em>not in the file</em>.</h1>

  <div class="af-prose">
    <p class="lead">
      It may have moved, been retired, or never existed outside the minutes.
    </p>

    <p>
      Return to <a href="/">Atmofrost</a>, or write to <a
        href="mailto:contact@atmofrost.org">contact@atmofrost.org</a
      > if you expected something specific here.
    </p>
  </div>
</Base>
