---
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import type { PageKey } from '@data/nav';
import '../styles/shared.css';

interface Props {
  title: string;
  description?: string;
  page?: PageKey;
}

const {
  title,
  description = 'Atmofrost Inc. for creating dreams and passion that redefine',
  page,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og.png', Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('af-theme');
          if (stored === 'dark') {
            document.documentElement.setAttribute('data-bg', 'dark');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body data-page={page}>
    <main class="af-page af-rise">
      <Header active={page} />
      <div class="af-content">
        <slot />
      </div>
      <Footer />
    </main>
  </body>
</html>
